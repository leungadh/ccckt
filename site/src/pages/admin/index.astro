---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="發佈內容">
  <h1 id="page-title">發佈內容</h1>

  <div id="type-chooser">
  <p class="type-prompt" id="type-prompt">請選擇要發佈的類型：</p>
  <div class="type-picker" role="radiogroup" aria-labelledby="type-prompt">
    <button type="button" class="type-option" role="radio" aria-checked="true" data-type="announcement">
      <span class="type-icon" aria-hidden="true">📢</span>公告
    </button>
    <button type="button" class="type-option" role="radio" aria-checked="false" data-type="sermon">
      <span class="type-icon" aria-hidden="true">📖</span>講道
    </button>
    <button type="button" class="type-option" role="radio" aria-checked="false" data-type="event">
      <span class="type-icon" aria-hidden="true">📅</span>活動
    </button>
  </div>
  <p class="type-hint" id="type-hint" aria-live="polite"></p>
  </div>

  <!-- Edit mode only: the type is fixed, so show it instead of the picker. -->
  <p class="edit-note" id="edit-note" hidden></p>

  <form id="content-form">
    <!-- 公告 -->
    <fieldset class="type-fields" data-type="announcement">
      <label for="ann-title">標題</label>
      <input type="text" id="ann-title" name="title" required />

      <div class="date-time">
        <div>
          <label for="ann-date">日期</label>
          <input type="date" id="ann-date" name="event_date" required />
        </div>
        <div>
          <label for="ann-time">時間（選填）</label>
          <input type="time" id="ann-time" name="start_time" />
        </div>
      </div>

      <label for="ann-body">內容</label>
      <textarea id="ann-body" name="body" required></textarea>

      <label for="ann-link">URL 連結（選填）</label>
      <input type="url" id="ann-link" name="link_url" placeholder="https://..." pattern="https?://.+" title="請輸入以 http:// 或 https:// 開頭的網址" />

      <label for="ann-file" id="ann-file-label">附件（選填，例如 PDF、Word、圖片）</label>
      <div class="file-choice" id="ann-file-choice" role="radiogroup" aria-labelledby="ann-file-label" hidden>
        <p class="current-file">目前檔案：<a id="ann-current-link" target="_blank" rel="noopener noreferrer"></a></p>
        <label class="radio"><input type="radio" name="ann_file_action" value="keep" checked /> 保留目前檔案</label>
        <label class="radio"><input type="radio" name="ann_file_action" value="replace" /> 更換為新檔案</label>
        <label class="radio"><input type="radio" name="ann_file_action" value="remove" /> 移除檔案</label>
      </div>
      <input type="file" id="ann-file" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png" />
    </fieldset>

    <!-- 講道 -->
    <fieldset class="type-fields" data-type="sermon" hidden disabled>
      <p class="field-label" id="ser-cat-label">類別</p>
      <div class="cat-picker" role="radiogroup" aria-labelledby="ser-cat-label">
        <label class="cat-option"><input type="radio" name="ser_category" value="worship" checked /><span>⛪ 崇拜</span></label>
        <label class="cat-option"><input type="radio" name="ser_category" value="seminar" /><span>🎓 專題講座</span></label>
      </div>

      <label for="ser-title">講題</label>
      <input type="text" id="ser-title" name="title" required />

      <div class="date-time">
        <div>
          <label for="ser-date">日期</label>
          <input type="date" id="ser-date" name="sermon_date" required />
        </div>
        <div>
          <label for="ser-time">時間（選填）</label>
          <input type="time" id="ser-time" name="start_time" />
        </div>
      </div>

      <label for="ser-speaker">講員</label>
      <input type="text" id="ser-speaker" name="speaker" required />

      <label for="ser-scripture">經文（選填）</label>
      <input type="text" id="ser-scripture" name="scripture" placeholder="例如：得二：11-12" />

      <label for="ser-file" id="ser-file-label">詩歌/經文 PDF 或 PPT</label>

      <!-- Edit mode, when the post already has a file: keep / replace / remove. -->
      <div class="file-choice" id="ser-file-choice" role="radiogroup" aria-labelledby="ser-file-label" hidden>
        <p class="current-file">目前檔案：<a id="ser-current-link" target="_blank" rel="noopener noreferrer"></a></p>
        <label class="radio"><input type="radio" name="ser_file_action" value="keep" checked /> 保留目前檔案</label>
        <label class="radio"><input type="radio" name="ser_file_action" value="replace" /> 更換為新檔案</label>
        <label class="radio"><input type="radio" name="ser_file_action" value="remove" /> 移除檔案</label>
      </div>

      <input type="file" id="ser-file" accept=".pdf,.ppt,.pptx" />

      <label for="ser-recording">錄影連結（YouTube，選填）</label>
      <input type="url" id="ser-recording" name="recording_url" placeholder="https://youtube.com/..." />

      <label for="ser-livestream">直播連結（選填，預備惡劣天氣使用）</label>
      <input type="url" id="ser-livestream" name="livestream_url" placeholder="https://youtube.com/..." />
    </fieldset>

    <!-- 活動 -->
    <fieldset class="type-fields" data-type="event" hidden disabled>
      <label for="ev-title">標題</label>
      <input type="text" id="ev-title" name="title" required />

      <label for="ev-at">日期及時間</label>
      <input type="datetime-local" id="ev-at" name="event_at" required />

      <label for="ev-desc">內容</label>
      <textarea id="ev-desc" name="description" required></textarea>

      <label for="ev-link">URL 連結（選填）</label>
      <input type="url" id="ev-link" name="link_url" placeholder="https://..." pattern="https?://.+" title="請輸入以 http:// 或 https:// 開頭的網址" />
    </fieldset>

    <div class="form-actions">
      <button type="submit" id="submit-btn">發佈公告</button>
      <a class="cancel-link" id="cancel-link" href="/admin/dashboard" hidden>取消，返回內容總覽</a>
    </div>
    <p class="msg" id="msg" role="status"></p>
  </form>
</AdminLayout>


<style is:global>
  .card .edit-note { margin: -0.75rem 0 1.75rem; padding-bottom: 1.5rem; border-bottom: 1px solid #e6e6e2; color: #555; }
  .card .edit-note strong { color: #0f6e6e; }
  .card .file-choice { margin-bottom: 0.75rem; padding: 0.9rem 1rem; background: #f7f7f5; border-radius: 6px; }
  .card .file-choice[hidden] { display: none; }
  .card .file-choice .current-file { margin: 0 0 0.6rem; overflow-wrap: anywhere; }
  .card .file-choice .current-file a { color: #0f6e6e; }
  .card label.radio {
    display: flex; align-items: center; gap: 0.5rem;
    margin: 0.35rem 0 0; font-weight: 400; font-size: 1rem; color: #1a1a1a; letter-spacing: 0;
  }
  .card label.radio input { width: auto; margin: 0; }
  .card input[type="file"]:disabled { opacity: 0.45; }
  /* 講道 類別: native radios shown as two pill buttons */
  .card .field-label { margin: 0 0 0.5rem; font-weight: 700; font-size: 1.05rem; color: #0f6e6e; }
  .card .cat-picker { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0.25rem; }
  .card .cat-picker + label { margin-top: 1.75rem; }
  .card label.cat-option { margin: 0; display: inline-flex; cursor: pointer; font-weight: 600; font-size: 1rem; color: #1a1a1a; letter-spacing: 0; }
  .card label.cat-option input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .card label.cat-option span { padding: 0.6rem 1.2rem; border: 2px solid #ccc; border-radius: 999px; background: white; }
  .card label.cat-option input:checked + span { border-color: #0f6e6e; background: #e8f4f4; color: #0f6e6e; box-shadow: 0 0 0 3px rgba(15, 110, 110, 0.15); }
  .card label.cat-option input:focus-visible + span { outline: 3px solid #0f6e6e; outline-offset: 2px; }
  /* The divider now sits under the hint, so the hint stays with the type buttons. */
  .card #type-chooser { margin-bottom: 1.75rem; padding-bottom: 1.4rem; border-bottom: 1px solid #e6e6e2; }
  .card #type-chooser .type-picker { margin-bottom: 0; padding-bottom: 0; border-bottom: 0; }
  .card .type-hint { margin: 0.85rem 0 0; font-size: 0.92rem; color: #555; }
  .card .type-hint[hidden] { display: none; }
  /* 日期 and 時間 side by side (stacked on narrow phones) */
  .card .date-time { display: grid; grid-template-columns: 1.4fr 1fr; gap: 0 1rem; }
  .card fieldset .date-time label { margin-top: 1.75rem; }
  @media (max-width: 420px) { .card .date-time { grid-template-columns: 1fr; } }
  .card .form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin-top: 2.5rem; }
  .card .form-actions button { margin-top: 0; }
  .card .cancel-link { color: #555; font-size: 0.98rem; }
  .card .cancel-link[hidden] { display: none; }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { requireAuth } from '../../lib/requireAuth';
  import { publicFileUrl, storageKey } from '../../lib/storage';

  await requireAuth();

  type ContentType = 'announcement' | 'sermon' | 'event';
  type Result = { error: { message: string } | null; uploadFailed?: boolean };

  const TABLE: Record<ContentType, 'announcements' | 'sermons' | 'events'> = {
    announcement: 'announcements',
    sermon: 'sermons',
    event: 'events',
  };
  const TYPE_NAME: Record<ContentType, string> = { announcement: '📢 公告', sermon: '📖 講道', event: '📅 活動' };
  const LABELS: Record<ContentType, { submit: string; success: string; failure: string }> = {
    announcement: { submit: '發佈公告', success: '公告已成功發佈！', failure: '發佈失敗' },
    sermon: { submit: '發佈講道', success: '講道已成功發佈！', failure: '發佈失敗' },
    event: { submit: '新增活動', success: '活動已成功新增！', failure: '新增失敗' },
  };

  // One line under the type buttons, so staff pick the right one.
  const HINTS: Record<ContentType, string> = {
    announcement: '教會消息及通知（主日崇拜的資料請用「講道」）',
    sermon: '主日崇拜及專題講座：講題、講員、經文、詩歌/經文、直播及錄影',
    event: '有日期的聚會，例如團契、旅行、節期崇拜',
  };
  // New 講道 start at the usual Sunday service time.
  const DEFAULT_SERMON_TIME = '11:00';

  const form = document.getElementById('content-form') as HTMLFormElement;
  const msg = document.getElementById('msg') as HTMLParagraphElement;
  const submitButton = document.getElementById('submit-btn') as HTMLButtonElement;
  const options = Array.from(document.querySelectorAll<HTMLButtonElement>('.type-option'));
  const fieldsets = Array.from(document.querySelectorAll<HTMLFieldSetElement>('.type-fields'));

  let current: ContentType = 'announcement';

  function isContentType(value: string | null): value is ContentType {
    return value === 'announcement' || value === 'sermon' || value === 'event';
  }

  function show(text: string, kind: 'error' | 'success' | '' = '') {
    msg.textContent = text;
    msg.className = kind ? `msg ${kind}` : 'msg';
  }

  function selectType(type: ContentType, updateUrl = true) {
    current = type;
    for (const opt of options) {
      const active = opt.dataset.type === type;
      opt.setAttribute('aria-checked', String(active));
      opt.tabIndex = active ? 0 : -1;
    }
    // Disabled fieldsets are skipped by `required` validation, so only the
    // visible type's fields are checked on submit.
    for (const fs of fieldsets) {
      const active = fs.dataset.type === type;
      fs.hidden = !active;
      fs.disabled = !active;
    }
    submitButton.textContent = LABELS[type].submit;
    field('type-hint').textContent = HINTS[type];
    show('');
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('type', type);
      history.replaceState(null, '', url);
    }
  }

  options.forEach((opt, i) => {
    opt.addEventListener('click', () => selectType(opt.dataset.type as ContentType));
    // Arrow keys move between options, as in a standard radio group.
    opt.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = options[(i + (e.key === 'ArrowRight' ? 1 : options.length - 1)) % options.length];
      selectType(next.dataset.type as ContentType);
      next.focus();
    });
  });

  function field<T extends HTMLElement = HTMLInputElement>(id: string) {
    return document.getElementById(id) as T;
  }

  // <input type="datetime-local"> wants local time "YYYY-MM-DDTHH:mm".
  function toLocalInput(iso: string) {
    const d = new Date(iso);
    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
  }

  // ---------- Edit mode: /admin/?edit=<id>&type=<type> (from the dashboard's 編輯) ----------
  const params = new URLSearchParams(window.location.search);
  const editId = params.get('edit');
  const editType = params.get('type');
  const editing = editId && isContentType(editType) ? { id: editId, type: editType } : null;
  // ---------- File fields (公告 attachment, 講道 詩歌/經文) ----------
  // A new post shows a plain file picker. When editing a post that already has
  // a file, the 保留／更換／移除 choice appears and the picker only applies to 更換.
  type FileAction = 'keep' | 'replace' | 'remove';
  function fileField(prefix: 'ann' | 'ser', bucket: string) {
    const choice = field<HTMLDivElement>(`${prefix}-file-choice`);
    const input = field(`${prefix}-file`);
    const radios = Array.from(document.querySelectorAll<HTMLInputElement>(`input[name="${prefix}_file_action"]`));
    let original: string | null = null;

    function sync() {
      if (choice.hidden) return;
      const action = radios.find((r) => r.checked)?.value;
      input.disabled = action !== 'replace';
      input.required = action === 'replace';
      if (input.disabled) input.value = '';
    }
    radios.forEach((r) => r.addEventListener('change', sync));

    return {
      bucket,
      get original() { return original; },
      // Edit mode: show the post's current file.
      showCurrent(path: string | null, displayName: string) {
        original = path;
        if (!path) return;
        const link = field<HTMLAnchorElement>(`${prefix}-current-link`);
        link.href = publicFileUrl(bucket, path);
        link.textContent = displayName;
        choice.hidden = false;
        sync();
      },
      action(): FileAction {
        return choice.hidden ? 'replace' : ((radios.find((r) => r.checked)?.value ?? 'keep') as FileAction);
      },
      file: () => input.files?.[0],
    };
  }
  const annFile = fileField('ann', 'announcement-files');
  const serFile = fileField('ser', 'sermon-files');

  // Works out the file columns for a save. Uploads first, so a failed upload
  // never leaves the post without its old file. Returns what to clean up after.
  async function prepareFile(
    ff: ReturnType<typeof fileField>,
    values: Record<string, unknown>,
    withName: boolean,
  ): Promise<{ uploaded: string | null; error?: string }> {
    const action = ff.action();
    const file = ff.file();
    if (action === 'replace' && file) {
      const key = storageKey(file.name);
      const { error } = await supabase.storage.from(ff.bucket).upload(key, file, { contentType: file.type || undefined });
      if (error) return { uploaded: null, error: `檔案上傳失敗：${error.message}` };
      values.file_path = key;
      if (withName) values.file_name = file.name;
      return { uploaded: key };
    }
    if (action === 'remove' || !editing) {
      values.file_path = null;
      if (withName) values.file_name = null;
    }
    return { uploaded: null };
  }

  // After the save: remove a fresh upload if the save failed, or the old file
  // if the post now points somewhere else.
  async function finishFile(ff: ReturnType<typeof fileField>, values: Record<string, unknown>, uploaded: string | null, ok: boolean) {
    if (!ok) {
      if (uploaded) await supabase.storage.from(ff.bucket).remove([uploaded]);
      return;
    }
    if (editing && ff.original && 'file_path' in values && values.file_path !== ff.original) {
      await supabase.storage.from(ff.bucket).remove([ff.original]);
    }
  }

  async function startEditing(id: string, type: ContentType) {
    selectType(type, false);
    document.title = `編輯${TYPE_NAME[type].slice(3)} · 基督中心堂管理後台`;
    field('page-title').textContent = `編輯${TYPE_NAME[type].slice(3)}`;
    field('type-chooser').hidden = true;
    const note = field('edit-note');
    note.textContent = '可修改以下所有內容（類型除外）';
    note.hidden = false;
    field('cancel-link').hidden = false;
    submitButton.textContent = '儲存修改';

    // Load the post and fill in the form.
    form.inert = true;
    show('載入中…');
    const { data: row, error } = await supabase.from(TABLE[type]).select('*').eq('id', id).maybeSingle();
    form.inert = false;
    if (error || !row) {
      show(error ? `載入失敗：${error.message}` : '找不到此內容，可能已被刪除。', 'error');
      submitButton.disabled = true;
      return;
    }
    show('');

    if (type === 'announcement') {
      field('ann-title').value = row.title;
      field('ann-date').value = row.event_date;
      field('ann-time').value = (row.start_time ?? '').slice(0, 5);
      field<HTMLTextAreaElement>('ann-body').value = row.body;
      field('ann-link').value = row.link_url ?? '';
      annFile.showCurrent(row.file_path, row.file_name ?? row.file_path);
    } else if (type === 'sermon') {
      field('ser-title').value = row.title;
      field('ser-date').value = row.sermon_date;
      field('ser-time').value = (row.start_time ?? '').slice(0, 5);
      field('ser-speaker').value = row.speaker;
      field('ser-scripture').value = row.scripture ?? '';
      field('ser-recording').value = row.recording_url ?? '';
      field('ser-livestream').value = row.livestream_url ?? '';
      const cat = document.querySelector<HTMLInputElement>(`input[name="ser_category"][value="${row.category ?? 'worship'}"]`);
      if (cat) cat.checked = true;
      serFile.showCurrent(row.file_path, (row.file_path ?? '').replace(/^\d+_/, '')); // hide the upload timestamp
    } else {
      field('ev-title').value = row.title;
      field('ev-at').value = toLocalInput(row.event_at);
      field<HTMLTextAreaElement>('ev-desc').value = row.description;
      field('ev-link').value = row.link_url ?? '';
    }
  }

  if (editing) {
    await startEditing(editing.id, editing.type);
  } else {
    const fromUrl = params.get('type');
    selectType(isContentType(fromUrl) ? fromUrl : 'announcement', false);
    field('ser-time').value = DEFAULT_SERMON_TIME;
  }

  // ---------- Saving ----------
  // An update that matches no row (deleted meanwhile, or no permission) comes
  // back without an error, so .select('id') is used to check a row really changed.
  async function save(type: ContentType, values: Record<string, unknown>): Promise<Result> {
    if (!editing) return supabase.from(TABLE[type]).insert(values);
    const { data, error } = await supabase.from(TABLE[type]).update(values).eq('id', editing.id).select('id');
    if (error) return { error };
    if (!data || data.length === 0) return { error: { message: '找不到此內容，可能已被刪除。' } };
    return { error: null };
  }

  async function submitAnnouncement(): Promise<Result> {
    const values: Record<string, unknown> = {
      title: field('ann-title').value,
      event_date: field('ann-date').value,
      start_time: field('ann-time').value || null,
      body: field<HTMLTextAreaElement>('ann-body').value,
      link_url: field('ann-link').value.trim() || null,
    };
    const prepared = await prepareFile(annFile, values, true);
    if (prepared.error) return { error: { message: prepared.error }, uploadFailed: true };
    const result = await save('announcement', values);
    await finishFile(annFile, values, prepared.uploaded, !result.error);
    return result;
  }

  async function submitSermon(): Promise<Result> {
    const values: Record<string, unknown> = {
      title: field('ser-title').value,
      sermon_date: field('ser-date').value,
      start_time: field('ser-time').value || null,
      speaker: field('ser-speaker').value,
      scripture: field('ser-scripture').value.trim() || null,
      recording_url: field('ser-recording').value || null,
      livestream_url: field('ser-livestream').value || null,
      category: document.querySelector<HTMLInputElement>('input[name="ser_category"]:checked')?.value ?? 'worship',
    };
    const prepared = await prepareFile(serFile, values, false);
    if (prepared.error) return { error: { message: prepared.error }, uploadFailed: true };
    const result = await save('sermon', values);
    await finishFile(serFile, values, prepared.uploaded, !result.error);
    return result;
  }

  async function submitEvent() {
    return save('event', {
      title: field('ev-title').value,
      event_at: new Date(field('ev-at').value).toISOString(),
      description: field<HTMLTextAreaElement>('ev-desc').value,
      link_url: field('ev-link').value.trim() || null,
    });
  }

  // Clear the last success/error message once the volunteer starts on the next post.
  form.addEventListener('input', () => {
    if (msg.textContent) show('');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const type = current;
    show('');
    submitButton.disabled = true;
    options.forEach((o) => (o.disabled = true));

    const result =
      type === 'announcement' ? await submitAnnouncement()
      : type === 'sermon' ? await submitSermon()
      : await submitEvent();

    submitButton.disabled = false;
    options.forEach((o) => (o.disabled = false));

    if (result.error) {
      const failure = editing ? '儲存失敗' : LABELS[type].failure;
      show(result.uploadFailed ? result.error.message : `${failure}：${result.error.message}`, 'error');
      return;
    }

    if (editing) {
      // Back to the dashboard, which shows 「已儲存」 for this post.
      const title = (fieldsets.find((fs) => fs.dataset.type === type)!.querySelector('input[name="title"]') as HTMLInputElement).value;
      window.location.href = `/admin/dashboard?saved=${encodeURIComponent(title)}`;
      return;
    }

    show(LABELS[type].success, 'success');
    fieldsets.find((fs) => fs.dataset.type === type)
      ?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type="radio"]), textarea')
      .forEach((input) => (input.value = ''));
    field('ser-time').value = DEFAULT_SERMON_TIME;
  });
</script>
