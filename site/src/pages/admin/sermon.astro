---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="發佈講道">
  <h1>發佈講道</h1>
  <form id="sermon-form">
    <label for="title">標題</label>
    <input type="text" id="title" name="title" required />

    <label for="sermon_date">日期</label>
    <input type="date" id="sermon_date" name="sermon_date" required />

    <label for="speaker">講員</label>
    <input type="text" id="speaker" name="speaker" required />

    <label for="file">詩歌/經文 PDF 或 PPT</label>
    <input type="file" id="file" name="file" accept=".pdf,.ppt,.pptx" />

    <label for="recording_url">錄影連結（YouTube，選填）</label>
    <input type="url" id="recording_url" name="recording_url" placeholder="https://youtube.com/..." />

    <label for="livestream_url">直播連結（選填，預備惡劣天氣使用）</label>
    <input type="url" id="livestream_url" name="livestream_url" placeholder="https://youtube.com/..." />

    <button type="submit">發佈</button>
    <p class="msg" id="msg"></p>
  </form>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { requireAuth } from '../../lib/requireAuth';

  await requireAuth();

  const form = document.getElementById('sermon-form') as HTMLFormElement;
  const msg = document.getElementById('msg') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.textContent = '';
    msg.className = 'msg';

    const submitButton = form.querySelector('button')!;
    submitButton.disabled = true;

    const title = (form.elements.namedItem('title') as HTMLInputElement).value;
    const sermon_date = (form.elements.namedItem('sermon_date') as HTMLInputElement).value;
    const speaker = (form.elements.namedItem('speaker') as HTMLInputElement).value;
    const recording_url = (form.elements.namedItem('recording_url') as HTMLInputElement).value || null;
    const livestream_url = (form.elements.namedItem('livestream_url') as HTMLInputElement).value || null;
    const fileInput = form.elements.namedItem('file') as HTMLInputElement;
    const file = fileInput.files?.[0];

    let file_path: string | null = null;

    if (file) {
      file_path = `${Date.now()}_${file.name}`;
      const { error: uploadError } = await supabase.storage
        .from('sermon-files')
        .upload(file_path, file);

      if (uploadError) {
        msg.textContent = `檔案上傳失敗：${uploadError.message}`;
        msg.className = 'msg error';
        submitButton.disabled = false;
        return;
      }
    }

    const { error } = await supabase
      .from('sermons')
      .insert({ title, sermon_date, speaker, file_path, recording_url, livestream_url });

    if (error) {
      msg.textContent = `發佈失敗：${error.message}`;
      msg.className = 'msg error';
      submitButton.disabled = false;
      return;
    }

    msg.textContent = '已成功發佈！';
    msg.className = 'msg success';
    form.reset();
    submitButton.disabled = false;
  });
</script>
