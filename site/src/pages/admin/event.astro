---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="新增活動">
  <h1>新增活動</h1>
  <form id="event-form">
    <label for="title">標題</label>
    <input type="text" id="title" name="title" required />

    <label for="event_at">日期及時間</label>
    <input type="datetime-local" id="event_at" name="event_at" required />

    <label for="description">內容</label>
    <textarea id="description" name="description" required></textarea>

    <button type="submit">新增</button>
    <p class="msg" id="msg"></p>
  </form>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { requireAuth } from '../../lib/requireAuth';

  await requireAuth();

  const form = document.getElementById('event-form') as HTMLFormElement;
  const msg = document.getElementById('msg') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.textContent = '';
    msg.className = 'msg';

    const submitButton = form.querySelector('button')!;
    submitButton.disabled = true;

    const title = (form.elements.namedItem('title') as HTMLInputElement).value;
    const event_at = (form.elements.namedItem('event_at') as HTMLInputElement).value;
    const description = (form.elements.namedItem('description') as HTMLTextAreaElement).value;

    const { error } = await supabase
      .from('events')
      .insert({ title, event_at: new Date(event_at).toISOString(), description });

    if (error) {
      msg.textContent = `新增失敗：${error.message}`;
      msg.className = 'msg error';
      submitButton.disabled = false;
      return;
    }

    msg.textContent = '已成功新增！';
    msg.className = 'msg success';
    form.reset();
    submitButton.disabled = false;
  });
</script>
