---
import PublicLayout from '../../layouts/PublicLayout.astro';
---
<PublicLayout title="聖道回顧">
  <h1>聖道回顧</h1>
  <div id="sermons-list" class="empty">載入中…</div>
</PublicLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { renderSermon } from '../../lib/sermonCard';

  async function loadSermons() {
    const container = document.getElementById('sermons-list')!;
    const { data, error } = await supabase
      .from('sermons')
      .select('*')
      .eq('is_published', true)
      .order('sermon_date', { ascending: false });

    if (error || !data || data.length === 0) {
      container.textContent = '暫無講道記錄。';
      return;
    }

    container.className = '';
    container.replaceChildren(
      ...data.map(renderSermon),
    );
  }

  loadSermons();
</script>
