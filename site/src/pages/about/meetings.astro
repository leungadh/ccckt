---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { worshipMeetings, fellowships, prayerMeeting } from '../../data/meetings';
---
<PublicLayout title="聚會介紹">
  <p><a href="/about">&larr; 教會概覽</a></p>
  <h1>聚會介紹</h1>

  <h2>崇拜及主日學</h2>
  <dl class="meeting-list">
    {worshipMeetings.map((m) => (
      <div><dt>{m.name}</dt><dd>{m.time}</dd></div>
    ))}
  </dl>

  <h2>團契</h2>
  <div class="fellowship-wrap">
    <table class="fellowship-table">
      <thead>
        <tr><th scope="col">名稱</th><th scope="col">聚會時間</th><th scope="col">對象</th><th scope="col">聚會地點</th></tr>
      </thead>
      <tbody>
        {fellowships.map((f) => (
          <tr>
            <th scope="row">{f.name}</th>
            <td data-label="聚會時間">{f.time}</td>
            <td data-label="對象">{f.audience}</td>
            <td data-label="聚會地點">{f.place}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>{prayerMeeting.name}</h2>
  <p class="meeting-time">{prayerMeeting.time}</p>
</PublicLayout>

<style>
  .meeting-list { margin: 0; display: grid; gap: 0; }
  .meeting-list div {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.2rem 1rem;
    padding: 0.6rem 0; border-bottom: 1px solid var(--color-surface-alt);
  }
  .meeting-list dt { font-weight: 700; color: var(--color-primary); }
  .meeting-list dd { margin: 0; color: var(--color-accent-dark); font-weight: 500; }

  .meeting-time { color: var(--color-accent-dark); font-weight: 500; }

  .fellowship-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .fellowship-table th, .fellowship-table td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-surface-alt); }
  .fellowship-table thead th { background: var(--color-surface-alt); color: var(--color-accent-dark); font-size: 0.88rem; font-weight: 700; }
  .fellowship-table thead th:first-child { border-top-left-radius: 8px; }
  .fellowship-table thead th:last-child { border-top-right-radius: 8px; }
  .fellowship-table tbody th { color: var(--color-primary); white-space: nowrap; }
  .fellowship-table tbody tr:hover { background: rgba(15, 128, 128, 0.04); }

  /* Phones: each 團契 becomes a small card instead of a squeezed 4-column row. */
  @media (max-width: 560px) {
    .fellowship-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .fellowship-table, .fellowship-table tbody, .fellowship-table tr, .fellowship-table th, .fellowship-table td { display: block; }
    .fellowship-table tr { padding: 0.7rem 0; border-bottom: 1px solid var(--color-surface-alt); }
    .fellowship-table th, .fellowship-table td { border: 0; padding: 0.1rem 0; }
    .fellowship-table tbody th { font-size: 1.02rem; margin-bottom: 0.2rem; }
    .fellowship-table td { display: flex; gap: 0.75rem; }
    .fellowship-table td::before { content: attr(data-label); color: var(--color-muted); font-size: 0.85rem; font-weight: 600; min-width: 4.5em; }
  }
</style>
