---
import PublicLayout from '../layouts/PublicLayout.astro';
---
<PublicLayout title="主頁">
  <div class="hero">
    <div class="hero-text">
      <h1>歡迎蒞臨基督中心堂（九龍塘）</h1>
      <p>主日崇拜時間：上午11:00 · 地址：九龍塘窩打老道144號</p>
      <div class="hero-actions">
        <a class="btn" href="/sermons">最新講道</a>
        <a class="btn secondary" href="/events">行事曆</a>
      </div>
    </div>
    <div class="hero-carousel" id="hero-carousel">
      <div class="carousel-track">
        <a class="carousel-slide" href="/about">
          <img src="/images/church_entrance_sign.jpg" alt="教會入口銅牌" width="456" height="161" />
          <span class="carousel-caption">教會概覽</span>
        </a>
        <a class="carousel-slide" href="/sermons">
          <img src="/images/book_shelf.jpg" alt="教會圖書角" width="456" height="161" />
          <span class="carousel-caption">聖道回顧</span>
        </a>
        <a class="carousel-slide" href="/events">
          <img src="/images/fish_pond_2.jpg" alt="教會錦鯉池" width="456" height="161" />
          <span class="carousel-caption">行事曆</span>
        </a>
        <a class="carousel-slide" href="/contact">
          <img src="/images/courtyard.jpg" alt="教會庭園一角" width="378" height="263" />
          <span class="carousel-caption">聯絡我們</span>
        </a>
      </div>
      <button class="carousel-nav carousel-prev" type="button" aria-label="上一張">‹</button>
      <button class="carousel-nav carousel-next" type="button" aria-label="下一張">›</button>
      <div class="carousel-dots">
        <button class="carousel-dot" type="button" aria-label="第 1 張"></button>
        <button class="carousel-dot" type="button" aria-label="第 2 張"></button>
        <button class="carousel-dot" type="button" aria-label="第 3 張"></button>
        <button class="carousel-dot" type="button" aria-label="第 4 張"></button>
      </div>
    </div>
  </div>

  <h2>最新公告</h2>
  <div id="announcements-list" class="empty">載入中…</div>

  <h2>最新講道</h2>
  <div id="sermons-list" class="empty">載入中…</div>

  <h2>活動</h2>
  <div id="events-list" class="empty">載入中…</div>
</PublicLayout>

<script>
  import { supabase } from '../lib/supabase';
  import { sermonFileUrl } from '../lib/sermonFileUrl';
  import { el, text } from '../lib/dom';
  import { formatDate, formatDateTime } from '../lib/format';

  async function loadAnnouncements() {
    const container = document.getElementById('announcements-list')!;
    const { data, error } = await supabase
      .from('announcements')
      .select('*')
      .order('event_date', { ascending: false })
      .limit(3);

    if (error || !data || data.length === 0) {
      container.textContent = '暫無公告。';
      return;
    }

    container.className = '';
    container.replaceChildren(
      ...data.map((item) => {
        const h3 = el('h3', {}, [text(item.title)]);
        const meta = el('div', { class: 'meta' }, [text(formatDate(item.event_date))]);
        const body = el('p', {}, [text(item.body)]);
        return el('div', { class: 'list-item' }, [h3, meta, body]);
      }),
    );
  }

  async function loadSermons() {
    const container = document.getElementById('sermons-list')!;
    const { data, error } = await supabase
      .from('sermons')
      .select('*')
      .order('sermon_date', { ascending: false })
      .limit(1);

    if (error || !data || data.length === 0) {
      container.textContent = '暫無講道記錄。';
      return;
    }

    container.className = '';
    container.replaceChildren(
      ...data.map((item) => {
        const h3 = el('h3', {}, [text(item.title)]);
        const meta = el('div', { class: 'meta' }, [text(`${formatDate(item.sermon_date)} · 講員：${item.speaker}`)]);
        const actions = el('div', { class: 'actions' });

        if (item.livestream_url) {
          actions.appendChild(el('a', { class: 'btn btn-live', href: item.livestream_url, target: '_blank' }, [text('📡 觀看直播')]));
        }
        if (item.recording_url) {
          actions.appendChild(el('a', { class: 'btn btn-secondary', href: item.recording_url, target: '_blank' }, [text('錄影')]));
        }
        if (item.file_path) {
          actions.appendChild(el('a', { class: 'btn btn-secondary', href: sermonFileUrl(item.file_path), target: '_blank' }, [text('詩歌/經文')]));
        }

        return el('div', { class: 'list-item' }, [h3, meta, actions]);
      }),
    );
  }

  async function loadEvents() {
    const container = document.getElementById('events-list')!;
    const { data, error } = await supabase
      .from('events')
      .select('*')
      .gte('event_at', new Date().toISOString())
      .order('event_at', { ascending: true })
      .limit(3);

    if (error || !data || data.length === 0) {
      container.textContent = '暫無活動。';
      return;
    }

    container.className = '';
    container.replaceChildren(
      ...data.map((item) => {
        const h3 = el('h3', {}, [text(item.title)]);
        const meta = el('div', { class: 'meta' }, [text(formatDateTime(item.event_at))]);
        const body = el('p', {}, [text(item.description)]);
        return el('div', { class: 'list-item' }, [h3, meta, body]);
      }),
    );
  }

  function initCarousel() {
    const root = document.getElementById('hero-carousel');
    if (!root) return;

    const track = root.querySelector<HTMLElement>('.carousel-track')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.carousel-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.carousel-dot'));
    let index = 0;

    function show(i: number) {
      index = (i + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, di) => dot.classList.toggle('active', di === index));
    }

    root.querySelector('.carousel-prev')!.addEventListener('click', () => show(index - 1));
    root.querySelector('.carousel-next')!.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, di) => dot.addEventListener('click', () => show(di)));

    show(0);
    setInterval(() => show(index + 1), 6000);
  }

  loadAnnouncements();
  loadSermons();
  loadEvents();
  initCarousel();
</script>
